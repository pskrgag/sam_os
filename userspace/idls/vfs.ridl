package Vfs;

type Path = Sequence<Char, 500>;
type Name = Sequence<Char, 500>;

interface Vfs {
	Root(out Handle handle);
}

enum DirEntryFlags : U8 {
	File,
	Directory,
}

struct DirEntry {
	Name name;
	DirEntryFlags flags;
}

interface Directory {
	List(out Sequence<DirEntry, 1000> entries);
	OpenFile(in Name name, in U8 create, out Handle handle);
	OpenDir(in Name name, in U8 create, out Handle handle);
}

interface File {
	Read(in USize size, in Handle vmo, out USize read);
	Write(in USize size, in Handle vmo, out USize write);
}
