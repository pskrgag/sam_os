package Pci;

type PhysAddr = U64;

struct PciMapping {
	PhysAddr base;
	U64 size;
	U8 index;
}

struct PciAddress {
	U16 segment;
	U8 bus;
	U8 device;
	U8 function;
}

struct DeviceId {
	U16 vendor;
	U16 device;
}

type PciDeviceData = Sequence<PciMapping, 6>;

interface Pci {
	Find(in DeviceId id, out Sequence<PciAddress, 32> addresses);
	Open(in PciAddress address, out Handle device);
}

interface Device {
	Map(out PciDeviceData data);
	AllocateIrq(out Handle irq);
}
